# ==========================================
# CampusOne — Environment Variables Guide
# ==========================================

# 1. Database (Required for Production 24/7 Cloud Hosting)
# For local development: Leave blank to use in-memory fallback, or point to local MongoDB
# For Vercel Production: Get your free M0 connection string from https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusone?retryWrites=true&w=majority

# 2. Authentication Secret (Required for JWT Signing)
# A secure random string for signing student session tokens
JWT_SECRET=campusone_production_jwt_secret_key_2026_dtu_secure

# 3. Server Configuration (Local Development)
PORT=5050
NODE_ENV=production

# 4. Meta & WhatsApp Integrations (Optional)
# Leave blank to operate in mock/demo mode automatically
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
